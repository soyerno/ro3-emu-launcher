<Project Sdk="Microsoft.NET.Sdk">
  <!-- Release tool for the signed update manifest: keygen, build, sign, verify. See docs/AUTO_UPDATE.md.
       It references the launcher so it builds, parses and verifies manifests with the launcher's own rules. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>ManifestTool</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Ro3Launcher.csproj" />
  </ItemGroup>
</Project>
