# Release settings (tools/release.py, .github/workflows/release.yml). A branded branch overrides keys in
# brand/release.env. Every download is pinned with its sha256; bump them in a pull request to ship a new release.
# A tag TAG_PREFIX<version> pushed on this branch publishes the release.
TAG_PREFIX=v
PACKAGE_NAME=ro3-launcher-patch
RELEASE_TITLE=RO3 Launcher
# RO3Emu.exe and its client/ hooks (asset RO3Emu-win-x64.zip of this release).
RO3EMU_REPO=aethai/ro3emu-server
RO3EMU_TAG=v1.0.19
RO3EMU_ZIP_SHA256=f45e8d8356a26a41e3d51ff7384fa3cbf783e9a5c1e974c9eb5bfe95ed3e0e2a
# cloudflared.exe, only needed when launcher.json opens tunnels (asset cloudflared-windows-amd64.exe). Empty: left out.
CLOUDFLARED_TAG=
CLOUDFLARED_SHA256=
